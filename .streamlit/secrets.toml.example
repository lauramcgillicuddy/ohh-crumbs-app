# Copy this file to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to git (it's already in .gitignore)

# Optional: Password protection for your app
ADMIN_PASSWORD = "your-password-here"

# Square API credentials (get from https://developer.squareup.com/)
SQUARE_ACCESS_TOKEN = "your-square-access-token"
SQUARE_LOCATION_ID = "your-location-id"

# OpenAI API Key for GPT-4 Vision OCR (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY = "sk-your-openai-api-key-here"

# Database URL will be set in Streamlit Cloud UI, not here
# For local development, use: sqlite:///bakery.db
